{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-on-gke.github.io/sandboxenv-rl/schema/v1/node_cache.schema.json",
  "title": "NodeCacheArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "collected_at", "nodes"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["v1"] },
    "run_id": { "type": "string", "minLength": 1 },
    "collected_at": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/NodeCacheSample" }
    }
  },
  "$defs": {
    "NodeCacheSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "hits", "misses"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "ts": { "type": "string" },
        "hits": { "type": "integer", "minimum": 0 },
        "misses": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "evictions": { "type": "integer", "minimum": 0 },
        "bytes_used": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
