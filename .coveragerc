[run]
branch = True
relative_files = True
disable_warnings =
    module-not-imported
    no-data-collected
source_pkgs =
    ate_env
    nemo_gym_substrate
    uni_agent_substrate
source =
    benchmarking/swebench
    benchmarking/telemetry_report
    internal/benchmarking/swebench/trajectories
    examples/Qwen3-1.7B-verl
omit =
    */_gen/*
    */tests/*
    **/test_*.py

[report]
skip_empty = True
show_missing = True

[paths]
ate_env =
    clients/python/src/ate_env
    src/ate_env
nemo_gym_substrate =
    integrations/nemo-gym/src/nemo_gym_substrate
    src/nemo_gym_substrate
uni_agent_substrate =
    integrations/uni-agent/src/uni_agent_substrate
    src/uni_agent_substrate
