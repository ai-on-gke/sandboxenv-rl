# Qwen3.5-397B-A17B on 16 GPU nodes, 1,024 prompts x 16 generations = 16,384 trajectories per step on R2E-Gym-V1 with the
# full 64K / 150-step episode budget: the production shape. SESSIONS is capped near what the 8 replicas decode at once
# (1.5 x 8 x ROLLOUT_MAX_NUM_SEQS), not the whole step: at 73K context a replica holds 64 sequences (H200), and a session
# queued inside vLLM holds a sandbox until SESSION_TIMEOUT_S. The rest of the step waits in uni-agent, holding no sandbox.
# Size the window from the README: the update on 8 trainer nodes takes about as long as the generation.
MODEL_ID=Qwen/Qwen3.5-397B-A17B
NNODES_TRAIN=8
NNODES_ROLLOUT=8
TRAIN_TP=2
TRAIN_CP=1
TRAIN_PP=8
TRAIN_EP=8
PP_EDGE_LAYERS=   # uneven first/last pipeline stage; empty = computed from the layer count
PARAM_OFFLOAD=True
ROLLOUT_TP=8
ROLLOUT_DP=1
ROLLOUT_EP=1
ROLLOUT_QUANT=fp8
ROLLOUT_GPU_MEM_UTIL=0.85
ROLLOUT_MAX_BATCHED_TOKENS=16384
ROLLOUT_MAX_NUM_SEQS=64   # sequences one replica holds in KV cache at MAX_MODEL_LEN (H200, 73K); vLLM logs "Maximum concurrency for N tokens per request" at start
PROMPT_LENGTH=8192
RESPONSE_LENGTH=65536
AGENT_MAX_STEPS=150
MASK_UNFINISHED_EPISODE=True   # 64K budget: train only on finished episodes; unfinished ones still count in the GRPO group
TRAIN_BATCH=1024
MINI_BATCH=512
SYNC_STEP=2
ROLLOUT_N=16
SESSIONS=768   # about 1.5 x 8 replicas x ROLLOUT_MAX_NUM_SEQS; set lower if the sandbox system cannot hold that many environments
GATEWAYS=8
AGENT_WORKERS=8
TOTAL_STEPS=7   # one epoch: performance numbers, not convergence. 2 = smoke; 21 = full (3 epochs; raise trainer.total_epochs in run_fully_async.sh)
SESSION_TIMEOUT_S=14400
SANDBOX_START_WAIT_S=1800
SANDBOX_STARTUP_CONCURRENCY=512   # job-wide gate on environment start-ups; SESSIONS / this x start latency (20-45 s warm) < SANDBOX_START_WAIT_S
RAY_CPUS=1024   # Ray CPU slots per node >= SESSIONS / GPU nodes (every session is a Ray task)
TRAIN_SOURCE=r2e_gym
TRAIN_DATASET=R2E-Gym/R2E-Gym-V1
TRAIN_SPLIT=train
TRAIN_SEED=0
TRAIN_INSTANCES=8101   # whole set (8101 rows); one epoch = floor(TRAIN_INSTANCES / TRAIN_BATCH) steps
VAL_TASKS=20
ATE_TEMPLATE=swe-1c4g   # Substrate actor template (booking per environment); must exist (README, Run step 1)
MEM_REQUEST=900Gi
EPH_REQUEST=1000Gi   # ephemeral storage per GPU pod for the checkpoint
