{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-on-gke.github.io/sandboxenv-rl/schema/v1/trace_event.schema.json",
  "title": "TraceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "env", "op", "dur_ms", "ok"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["v1"] },
    "ts": { "type": "string", "minLength": 1 },
    "run": { "type": "string" },
    "job": { "type": "string" },
    "env": { "type": "string", "minLength": 1 },
    "instance": { "type": "string" },
    "image": { "type": "string" },
    "step": { "type": "integer", "minimum": 0 },
    "op": {
      "type": "string",
      "enum": [
        "create",
        "exec",
        "write_file",
        "read_file",
        "suspend",
        "wake",
        "fork",
        "delete",
        "get",
        "start_process",
        "shell"
      ]
    },
    "command": {
      "type": "array",
      "items": { "type": "string" }
    },
    "path": { "type": "string" },
    "bytes": { "type": "integer", "minimum": 0 },
    "dur_ms": { "type": "number", "minimum": 0 },
    "exit": { "type": "integer" },
    "ok": { "type": "boolean" },
    "err": { "type": "string" }
  }
}
